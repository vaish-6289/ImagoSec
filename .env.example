# Copy this file to .env and populate the values below.
# The app will load them automatically when running locally.

# Azure SQL connection string for production mode.
# Example:
# AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:sr-imagosec.database.windows.net,1433;Database=db-imagosec;Uid=<username>@sr-imagosec;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"
AZURE_SQL_CONNECTION_STRING=""

# Azure Blob Storage connection string for optional upload fallback.
# Example:
# AZURE_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=stimagosec;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net"
AZURE_BLOB_CONNECTION_STRING=""

# Optional container override used for captured image uploads.
AZURE_BLOB_CONTAINER="imagosec-ingestion"

# Optional local SQLite path for the no-cloud fallback mode.
LOCAL_SQLITE_PATH="local_evaluation_ledger.db"
